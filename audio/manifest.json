{
 "voice": "af_heart",
 "engine": "Kokoro-82M (kokoro-onnx)",
 "clips": {
  "p001": {
   "text": "How about going shopping?",
   "normal": "normal/p001.mp3",
   "slow": "slow/p001.mp3"
  },
  "p002": {
   "text": "Why don't we play tennis?",
   "normal": "normal/p002.mp3",
   "slow": "slow/p002.mp3"
  },
  "p003": {
   "text": "Would you like to come with us?",
   "normal": "normal/p003.mp3",
   "slow": "slow/p003.mp3"
  },
  "p004": {
   "text": "Shall I open the window?",
   "normal": "normal/p004.mp3",
   "slow": "slow/p004.mp3"
  },
  "p005": {
   "text": "How many books do you have?",
   "normal": "normal/p005.mp3",
   "slow": "slow/p005.mp3"
  },
  "p006": {
   "text": "How much is this bag?",
   "normal": "normal/p006.mp3",
   "slow": "slow/p006.mp3"
  },
  "p007": {
   "text": "How long did you stay there?",
   "normal": "normal/p007.mp3",
   "slow": "slow/p007.mp3"
  },
  "p008": {
   "text": "How often do you play tennis?",
   "normal": "normal/p008.mp3",
   "slow": "slow/p008.mp3"
  },
  "p009": {
   "text": "What time do you get up?",
   "normal": "normal/p009.mp3",
   "slow": "slow/p009.mp3"
  },
  "p010": {
   "text": "What kind of music do you like?",
   "normal": "normal/p010.mp3",
   "slow": "slow/p010.mp3"
  },
  "p011": {
   "text": "Can I use your pen?",
   "normal": "normal/p011.mp3",
   "slow": "slow/p011.mp3"
  },
  "p012": {
   "text": "May I come in?",
   "normal": "normal/p012.mp3",
   "slow": "slow/p012.mp3"
  },
  "p013": {
   "text": "Could you help me?",
   "normal": "normal/p013.mp3",
   "slow": "slow/p013.mp3"
  },
  "p014": {
   "text": "Let's go to the park.",
   "normal": "normal/p014.mp3",
   "slow": "slow/p014.mp3"
  },
  "p015": {
   "text": "Don't run in the hall.",
   "normal": "normal/p015.mp3",
   "slow": "slow/p015.mp3"
  },
  "p016": {
   "text": "Nice to meet you, Ken.",
   "normal": "normal/p016.mp3",
   "slow": "slow/p016.mp3"
  },
  "p017": {
   "text": "Thank you for coming.",
   "normal": "normal/p017.mp3",
   "slow": "slow/p017.mp3"
  },
  "p018": {
   "text": "I'm sorry I'm late.",
   "normal": "normal/p018.mp3",
   "slow": "slow/p018.mp3"
  },
  "p019": {
   "text": "Here you are.",
   "normal": "normal/p019.mp3",
   "slow": "slow/p019.mp3"
  },
  "p020": {
   "text": "Good luck on your test!",
   "normal": "normal/p020.mp3",
   "slow": "slow/p020.mp3"
  },
  "p021": {
   "text": "What's wrong with you?",
   "normal": "normal/p021.mp3",
   "slow": "slow/p021.mp3"
  },
  "p022": {
   "text": "Just a moment, please.",
   "normal": "normal/p022.mp3",
   "slow": "slow/p022.mp3"
  },
  "p023": {
   "text": "That sounds good.",
   "normal": "normal/p023.mp3",
   "slow": "slow/p023.mp3"
  },
  "p024": {
   "text": "I'd like some water.",
   "normal": "normal/p024.mp3",
   "slow": "slow/p024.mp3"
  },
  "p025": {
   "text": "There are two cats in the garden.",
   "normal": "normal/p025.mp3",
   "slow": "slow/p025.mp3"
  },
  "p026": {
   "text": "It's time to go to bed.",
   "normal": "normal/p026.mp3",
   "slow": "slow/p026.mp3"
  },
  "p027": {
   "text": "I'm looking for my key.",
   "normal": "normal/p027.mp3",
   "slow": "slow/p027.mp3"
  },
  "p028": {
   "text": "Look at this picture.",
   "normal": "normal/p028.mp3",
   "slow": "slow/p028.mp3"
  },
  "p029": {
   "text": "I'm looking forward to seeing you.",
   "normal": "normal/p029.mp3",
   "slow": "slow/p029.mp3"
  },
  "p030": {
   "text": "She looks like her mother.",
   "normal": "normal/p030.mp3",
   "slow": "slow/p030.mp3"
  },
  "p031": {
   "text": "I take care of my dog.",
   "normal": "normal/p031.mp3",
   "slow": "slow/p031.mp3"
  },
  "p032": {
   "text": "He took part in the contest.",
   "normal": "normal/p032.mp3",
   "slow": "slow/p032.mp3"
  },
  "p033": {
   "text": "I get up at six.",
   "normal": "normal/p033.mp3",
   "slow": "slow/p033.mp3"
  },
  "p034": {
   "text": "We got to the station at nine.",
   "normal": "normal/p034.mp3",
   "slow": "slow/p034.mp3"
  },
  "p035": {
   "text": "I have to do my homework.",
   "normal": "normal/p035.mp3",
   "slow": "slow/p035.mp3"
  },
  "p036": {
   "text": "I come from Tokyo.",
   "normal": "normal/p036.mp3",
   "slow": "slow/p036.mp3"
  },
  "p037": {
   "text": "He will come back soon.",
   "normal": "normal/p037.mp3",
   "slow": "slow/p037.mp3"
  },
  "p038": {
   "text": "Please go on with your story.",
   "normal": "normal/p038.mp3",
   "slow": "slow/p038.mp3"
  },
  "p039": {
   "text": "I'm waiting for the bus.",
   "normal": "normal/p039.mp3",
   "slow": "slow/p039.mp3"
  },
  "p040": {
   "text": "I talked to my teacher.",
   "normal": "normal/p040.mp3",
   "slow": "slow/p040.mp3"
  },
  "p041": {
   "text": "I'm thinking about my future.",
   "normal": "normal/p041.mp3",
   "slow": "slow/p041.mp3"
  },
  "p042": {
   "text": "I listen to music every day.",
   "normal": "normal/p042.mp3",
   "slow": "slow/p042.mp3"
  },
  "p043": {
   "text": "Put on your coat.",
   "normal": "normal/p043.mp3",
   "slow": "slow/p043.mp3"
  },
  "p044": {
   "text": "Take off your shoes.",
   "normal": "normal/p044.mp3",
   "slow": "slow/p044.mp3"
  },
  "p045": {
   "text": "Turn off the TV.",
   "normal": "normal/p045.mp3",
   "slow": "slow/p045.mp3"
  },
  "p046": {
   "text": "Don't give up!",
   "normal": "normal/p046.mp3",
   "slow": "slow/p046.mp3"
  },
  "p047": {
   "text": "Please sit down.",
   "normal": "normal/p047.mp3",
   "slow": "slow/p047.mp3"
  },
  "p048": {
   "text": "Stand up, please.",
   "normal": "normal/p048.mp3",
   "slow": "slow/p048.mp3"
  },
  "p049": {
   "text": "I woke up at seven.",
   "normal": "normal/p049.mp3",
   "slow": "slow/p049.mp3"
  },
  "p050": {
   "text": "I go to the library every week.",
   "normal": "normal/p050.mp3",
   "slow": "slow/p050.mp3"
  },
  "p051": {
   "text": "Let's go shopping tomorrow.",
   "normal": "normal/p051.mp3",
   "slow": "slow/p051.mp3"
  },
  "p052": {
   "text": "I go home at five.",
   "normal": "normal/p052.mp3",
   "slow": "slow/p052.mp3"
  },
  "p053": {
   "text": "Don't go out in the rain.",
   "normal": "normal/p053.mp3",
   "slow": "slow/p053.mp3"
  },
  "p054": {
   "text": "Please come in.",
   "normal": "normal/p054.mp3",
   "slow": "slow/p054.mp3"
  },
  "p055": {
   "text": "We had a good time at the party.",
   "normal": "normal/p055.mp3",
   "slow": "slow/p055.mp3"
  },
  "p056": {
   "text": "I have lunch with my friends.",
   "normal": "normal/p056.mp3",
   "slow": "slow/p056.mp3"
  },
  "p057": {
   "text": "She has a cold today.",
   "normal": "normal/p057.mp3",
   "slow": "slow/p057.mp3"
  },
  "p058": {
   "text": "I will do my best.",
   "normal": "normal/p058.mp3",
   "slow": "slow/p058.mp3"
  },
  "p059": {
   "text": "I do my homework after dinner.",
   "normal": "normal/p059.mp3",
   "slow": "slow/p059.mp3"
  },
  "p060": {
   "text": "My sister plays the piano.",
   "normal": "normal/p060.mp3",
   "slow": "slow/p060.mp3"
  },
  "p061": {
   "text": "Can you speak English?",
   "normal": "normal/p061.mp3",
   "slow": "slow/p061.mp3"
  },
  "p062": {
   "text": "He looked around the room.",
   "normal": "normal/p062.mp3",
   "slow": "slow/p062.mp3"
  },
  "p063": {
   "text": "Look out! A car is coming.",
   "normal": "normal/p063.mp3",
   "slow": "slow/p063.mp3"
  },
  "p064": {
   "text": "She looks after her little brother.",
   "normal": "normal/p064.mp3",
   "slow": "slow/p064.mp3"
  },
  "p065": {
   "text": "Look up the word in a dictionary.",
   "normal": "normal/p065.mp3",
   "slow": "slow/p065.mp3"
  },
  "p066": {
   "text": "I take a bus to school.",
   "normal": "normal/p066.mp3",
   "slow": "slow/p066.mp3"
  },
  "p067": {
   "text": "Let me take a picture of you.",
   "normal": "normal/p067.mp3",
   "slow": "slow/p067.mp3"
  },
  "p068": {
   "text": "I take a shower every morning.",
   "normal": "normal/p068.mp3",
   "slow": "slow/p068.mp3"
  },
  "p069": {
   "text": "Let's take a rest here.",
   "normal": "normal/p069.mp3",
   "slow": "slow/p069.mp3"
  },
  "p070": {
   "text": "Take out your notebook.",
   "normal": "normal/p070.mp3",
   "slow": "slow/p070.mp3"
  },
  "p071": {
   "text": "I got home at six.",
   "normal": "normal/p071.mp3",
   "slow": "slow/p071.mp3"
  },
  "p072": {
   "text": "Get out of the car.",
   "normal": "normal/p072.mp3",
   "slow": "slow/p072.mp3"
  },
  "p073": {
   "text": "Get ready for school.",
   "normal": "normal/p073.mp3",
   "slow": "slow/p073.mp3"
  },
  "p074": {
   "text": "I hope you get well soon.",
   "normal": "normal/p074.mp3",
   "slow": "slow/p074.mp3"
  },
  "p075": {
   "text": "Give me a hand, please.",
   "normal": "normal/p075.mp3",
   "slow": "slow/p075.mp3"
  },
  "p076": {
   "text": "I made a mistake on the test.",
   "normal": "normal/p076.mp3",
   "slow": "slow/p076.mp3"
  },
  "p077": {
   "text": "Let's make a plan for the trip.",
   "normal": "normal/p077.mp3",
   "slow": "slow/p077.mp3"
  },
  "p078": {
   "text": "Make a wish.",
   "normal": "normal/p078.mp3",
   "slow": "slow/p078.mp3"
  },
  "p079": {
   "text": "Put away your toys.",
   "normal": "normal/p079.mp3",
   "slow": "slow/p079.mp3"
  },
  "p080": {
   "text": "I said goodbye to my friends.",
   "normal": "normal/p080.mp3",
   "slow": "slow/p080.mp3"
  },
  "p081": {
   "text": "Please tell me the truth.",
   "normal": "normal/p081.mp3",
   "slow": "slow/p081.mp3"
  },
  "p082": {
   "text": "May I ask a question?",
   "normal": "normal/p082.mp3",
   "slow": "slow/p082.mp3"
  },
  "p083": {
   "text": "I'll call you back later.",
   "normal": "normal/p083.mp3",
   "slow": "slow/p083.mp3"
  },
  "p084": {
   "text": "She is good at playing the piano.",
   "normal": "normal/p084.mp3",
   "slow": "slow/p084.mp3"
  },
  "p085": {
   "text": "I'm interested in science.",
   "normal": "normal/p085.mp3",
   "slow": "slow/p085.mp3"
  },
  "p086": {
   "text": "Osaka is famous for its food.",
   "normal": "normal/p086.mp3",
   "slow": "slow/p086.mp3"
  },
  "p087": {
   "text": "I'm afraid of dogs.",
   "normal": "normal/p087.mp3",
   "slow": "slow/p087.mp3"
  },
  "p088": {
   "text": "I'm proud of my team.",
   "normal": "normal/p088.mp3",
   "slow": "slow/p088.mp3"
  },
  "p089": {
   "text": "Don't be late for school.",
   "normal": "normal/p089.mp3",
   "slow": "slow/p089.mp3"
  },
  "p090": {
   "text": "The box is full of toys.",
   "normal": "normal/p090.mp3",
   "slow": "slow/p090.mp3"
  },
  "p091": {
   "text": "She is kind to everyone.",
   "normal": "normal/p091.mp3",
   "slow": "slow/p091.mp3"
  },
  "p092": {
   "text": "I'm going to study tonight.",
   "normal": "normal/p092.mp3",
   "slow": "slow/p092.mp3"
  },
  "p093": {
   "text": "He is able to speak three languages.",
   "normal": "normal/p093.mp3",
   "slow": "slow/p093.mp3"
  },
  "p094": {
   "text": "There is a tree in front of the school.",
   "normal": "normal/p094.mp3",
   "slow": "slow/p094.mp3"
  },
  "p095": {
   "text": "The bank is next to the library.",
   "normal": "normal/p095.mp3",
   "slow": "slow/p095.mp3"
  },
  "p096": {
   "text": "The game was canceled because of rain.",
   "normal": "normal/p096.mp3",
   "slow": "slow/p096.mp3"
  },
  "p097": {
   "text": "In fact, I don't like fish.",
   "normal": "normal/p097.mp3",
   "slow": "slow/p097.mp3"
  },
  "p098": {
   "text": "Of course, you can use it.",
   "normal": "normal/p098.mp3",
   "slow": "slow/p098.mp3"
  },
  "p099": {
   "text": "At first, I was nervous.",
   "normal": "normal/p099.mp3",
   "slow": "slow/p099.mp3"
  },
  "p100": {
   "text": "At last, we arrived.",
   "normal": "normal/p100.mp3",
   "slow": "slow/p100.mp3"
  },
  "p101": {
   "text": "I like sports, for example, soccer.",
   "normal": "normal/p101.mp3",
   "slow": "slow/p101.mp3"
  },
  "p102": {
   "text": "I have studied English for a long time.",
   "normal": "normal/p102.mp3",
   "slow": "slow/p102.mp3"
  },
  "p103": {
   "text": "She has a lot of books.",
   "normal": "normal/p103.mp3",
   "slow": "slow/p103.mp3"
  },
  "p104": {
   "text": "He is one of my best friends.",
   "normal": "normal/p104.mp3",
   "slow": "slow/p104.mp3"
  },
  "p105": {
   "text": "We help each other.",
   "normal": "normal/p105.mp3",
   "slow": "slow/p105.mp3"
  },
  "p106": {
   "text": "One day, I met a girl.",
   "normal": "normal/p106.mp3",
   "slow": "slow/p106.mp3"
  },
  "p107": {
   "text": "By the way, what time is it?",
   "normal": "normal/p107.mp3",
   "slow": "slow/p107.mp3"
  },
  "p108": {
   "text": "I stay at home on Sundays.",
   "normal": "normal/p108.mp3",
   "slow": "slow/p108.mp3"
  },
  "p109": {
   "text": "He is at school now.",
   "normal": "normal/p109.mp3",
   "slow": "slow/p109.mp3"
  },
  "p110": {
   "text": "The stars shine at night.",
   "normal": "normal/p110.mp3",
   "slow": "slow/p110.mp3"
  },
  "p111": {
   "text": "I run in the morning.",
   "normal": "normal/p111.mp3",
   "slow": "slow/p111.mp3"
  },
  "p112": {
   "text": "I go to school on foot.",
   "normal": "normal/p112.mp3",
   "slow": "slow/p112.mp3"
  },
  "p113": {
   "text": "He goes to work by bus.",
   "normal": "normal/p113.mp3",
   "slow": "slow/p113.mp3"
  },
  "p114": {
   "text": "We went there by train.",
   "normal": "normal/p114.mp3",
   "slow": "slow/p114.mp3"
  },
  "p115": {
   "text": "My house is over there.",
   "normal": "normal/p115.mp3",
   "slow": "slow/p115.mp3"
  },
  "p116": {
   "text": "It rained all day.",
   "normal": "normal/p116.mp3",
   "slow": "slow/p116.mp3"
  },
  "p117": {
   "text": "I study English every day.",
   "normal": "normal/p117.mp3",
   "slow": "slow/p117.mp3"
  },
  "p118": {
   "text": "I woke up late this morning.",
   "normal": "normal/p118.mp3",
   "slow": "slow/p118.mp3"
  },
  "p119": {
   "text": "I slept well last night.",
   "normal": "normal/p119.mp3",
   "slow": "slow/p119.mp3"
  },
  "p120": {
   "text": "We have a test next week.",
   "normal": "normal/p120.mp3",
   "slow": "slow/p120.mp3"
  },
  "p121": {
   "text": "I'd like a cup of tea.",
   "normal": "normal/p121.mp3",
   "slow": "slow/p121.mp3"
  },
  "p122": {
   "text": "He ate a piece of cake.",
   "normal": "normal/p122.mp3",
   "slow": "slow/p122.mp3"
  },
  "p123": {
   "text": "She drank a glass of water.",
   "normal": "normal/p123.mp3",
   "slow": "slow/p123.mp3"
  },
  "p124": {
   "text": "You eat too much.",
   "normal": "normal/p124.mp3",
   "slow": "slow/p124.mp3"
  },
  "p125": {
   "text": "I speak a little English.",
   "normal": "normal/p125.mp3",
   "slow": "slow/p125.mp3"
  },
  "p126": {
   "text": "They arrived at the same time.",
   "normal": "normal/p126.mp3",
   "slow": "slow/p126.mp3"
  },
  "p127": {
   "text": "He is as tall as his father.",
   "normal": "normal/p127.mp3",
   "slow": "slow/p127.mp3"
  },
  "p128": {
   "text": "Both Ken and Mike like baseball.",
   "normal": "normal/p128.mp3",
   "slow": "slow/p128.mp3"
  },
  "p129": {
   "text": "I was so tired that I went to bed early.",
   "normal": "normal/p129.mp3",
   "slow": "slow/p129.mp3"
  },
  "p130": {
   "text": "It is too cold to swim.",
   "normal": "normal/p130.mp3",
   "slow": "slow/p130.mp3"
  },
  "p131": {
   "text": "Thank you for your help.",
   "normal": "normal/p131.mp3",
   "slow": "slow/p131.mp3"
  },
  "p132": {
   "text": "I asked him to help me.",
   "normal": "normal/p132.mp3",
   "slow": "slow/p132.mp3"
  },
  "p133": {
   "text": "My mother told me to clean my room.",
   "normal": "normal/p133.mp3",
   "slow": "slow/p133.mp3"
  },
  "p134": {
   "text": "I want you to come.",
   "normal": "normal/p134.mp3",
   "slow": "slow/p134.mp3"
  },
  "p135": {
   "text": "She helped me do my homework.",
   "normal": "normal/p135.mp3",
   "slow": "slow/p135.mp3"
  },
  "p136": {
   "text": "It takes ten minutes to walk to the station.",
   "normal": "normal/p136.mp3",
   "slow": "slow/p136.mp3"
  },
  "p137": {
   "text": "Let me see... It's on the table.",
   "normal": "normal/p137.mp3",
   "slow": "slow/p137.mp3"
  },
  "p138": {
   "text": "Would you mind opening the window?",
   "normal": "normal/p138.mp3",
   "slow": "slow/p138.mp3"
  },
  "p139": {
   "text": "Let's take a walk after dinner.",
   "normal": "normal/p139.mp3",
   "slow": "slow/p139.mp3"
  },
  "p140": {
   "text": "Get off the bus at the next stop.",
   "normal": "normal/p140.mp3",
   "slow": "slow/p140.mp3"
  },
  "p141": {
   "text": "I hope you get better soon.",
   "normal": "normal/p141.mp3",
   "slow": "slow/p141.mp3"
  },
  "p142": {
   "text": "I made friends with a new student.",
   "normal": "normal/p142.mp3",
   "slow": "slow/p142.mp3"
  },
  "p143": {
   "text": "He made a speech in class.",
   "normal": "normal/p143.mp3",
   "slow": "slow/p143.mp3"
  },
  "p144": {
   "text": "Say hello to your family.",
   "normal": "normal/p144.mp3",
   "slow": "slow/p144.mp3"
  },
  "p145": {
   "text": "Please turn down the radio.",
   "normal": "normal/p145.mp3",
   "slow": "slow/p145.mp3"
  },
  "p146": {
   "text": "I grew up in Tokyo.",
   "normal": "normal/p146.mp3",
   "slow": "slow/p146.mp3"
  },
  "p147": {
