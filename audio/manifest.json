  "p293": {
   "text": "There are many kinds of flowers.",
   "normal": "normal/p293.mp3",
   "slow": "slow/p293.mp3"
  },
  "p294": {
   "text": "More than 100 people came.",
   "normal": "normal/p294.mp3",
   "slow": "slow/p294.mp3"
  },
  "p295": {
   "text": "I'm not tired at all.",
   "normal": "normal/p295.mp3",
   "slow": "slow/p295.mp3"
  },
  "p296": {
   "text": "Rich people are not always happy.",
   "normal": "normal/p296.mp3",
   "slow": "slow/p296.mp3"
  },
  "p297": {
   "text": "He no longer lives here.",
   "normal": "normal/p297.mp3",
   "slow": "slow/p297.mp3"
  },
  "p298": {
   "text": "No one knows the answer.",
   "normal": "normal/p298.mp3",
   "slow": "slow/p298.mp3"
  },
  "p299": {
   "text": "None of them came.",
   "normal": "normal/p299.mp3",
   "slow": "slow/p299.mp3"
  },
  "p300": {
   "text": "I met him on my way home.",
   "normal": "normal/p300.mp3",
   "slow": "slow/p300.mp3"
  },
  "p301": {
   "text": "She is on the phone.",
   "normal": "normal/p301.mp3",
   "slow": "slow/p301.mp3"
  },
  "p302": {
   "text": "He lives on the other side of the river.",
   "normal": "normal/p302.mp3",
   "slow": "slow/p302.mp3"
  },
  "p303": {
   "text": "I swim once a week.",
   "normal": "normal/p303.mp3",
   "slow": "slow/p303.mp3"
  },
  "p304": {
   "text": "Once upon a time, there lived a king.",
   "normal": "normal/p304.mp3",
   "slow": "slow/p304.mp3"
  },
  "p305": {
   "text": "I read the book over and over.",
   "normal": "normal/p305.mp3",
   "slow": "slow/p305.mp3"
  },
  "p306": {
   "text": "I like tea rather than coffee.",
   "normal": "normal/p306.mp3",
   "slow": "slow/p306.mp3"
  },
  "p307": {
   "text": "Sooner or later, you will understand.",
   "normal": "normal/p307.mp3",
   "slow": "slow/p307.mp3"
  },
  "p308": {
   "text": "I saw him the other day.",
   "normal": "normal/p308.mp3",
   "slow": "slow/p308.mp3"
  },
  "p309": {
   "text": "I met her the day before yesterday.",
   "normal": "normal/p309.mp3",
   "slow": "slow/p309.mp3"
  },
  "p310": {
   "text": "The next day, it snowed.",
   "normal": "normal/p310.mp3",
   "slow": "slow/p310.mp3"
  },
  "p311": {
   "text": "These days, I get up early.",
   "normal": "normal/p311.mp3",
   "slow": "slow/p311.mp3"
  },
  "p312": {
   "text": "Let me know your plan.",
   "normal": "normal/p312.mp3",
   "slow": "slow/p312.mp3"
  },
  "p313": {
   "text": "Call me as soon as you arrive.",
   "normal": "normal/p313.mp3",
   "slow": "slow/p313.mp3"
  },
  "p314": {
   "text": "I like sports such as tennis.",
   "normal": "normal/p314.mp3",
   "slow": "slow/p314.mp3"
  },
  "p315": {
   "text": "I'll take you to the station.",
   "normal": "normal/p315.mp3",
   "slow": "slow/p315.mp3"
  },
  "p316": {
   "text": "Tell me about your family.",
   "normal": "normal/p316.mp3",
   "slow": "slow/p316.mp3"
  },
  "p317": {
   "text": "This is the same as that.",
   "normal": "normal/p317.mp3",
   "slow": "slow/p317.mp3"
  },
  "p318": {
   "text": "We use knives for cutting.",
   "normal": "normal/p318.mp3",
   "slow": "slow/p318.mp3"
  },
  "p319": {
   "text": "I don't know what to do.",
   "normal": "normal/p319.mp3",
   "slow": "slow/p319.mp3"
  },
  "p320": {
   "text": "I know how to cook.",
   "normal": "normal/p320.mp3",
   "slow": "slow/p320.mp3"
  },
  "p321": {
   "text": "I get along with my classmates.",
   "normal": "normal/p321.mp3",
   "slow": "slow/p321.mp3"
  },
  "p322": {
   "text": "It depends on the weather.",
   "normal": "normal/p322.mp3",
   "slow": "slow/p322.mp3"
  },
  "p323": {
   "text": "I made up my mind to study hard.",
   "normal": "normal/p323.mp3",
   "slow": "slow/p323.mp3"
  },
  "p324": {
   "text": "I used to play soccer.",
   "normal": "normal/p324.mp3",
   "slow": "slow/p324.mp3"
  },
  "p325": {
   "text": "You had better see a doctor.",
   "normal": "normal/p325.mp3",
   "slow": "slow/p325.mp3"
  },
  "p326": {
   "text": "I heard from my uncle yesterday.",
   "normal": "normal/p326.mp3",
   "slow": "slow/p326.mp3"
  },
  "p327": {
   "text": "Please pick up that paper.",
   "normal": "normal/p327.mp3",
   "slow": "slow/p327.mp3"
  },
  "p328": {
   "text": "Can I try on this jacket?",
   "normal": "normal/p328.mp3",
   "slow": "slow/p328.mp3"
  },
  "p329": {
   "text": "I found out the answer.",
   "normal": "normal/p329.mp3",
   "slow": "slow/p329.mp3"
  },
  "p330": {
   "text": "I came across an old friend.",
   "normal": "normal/p330.mp3",
   "slow": "slow/p330.mp3"
  },
  "p331": {
   "text": "We have to deal with the problem.",
   "normal": "normal/p331.mp3",
   "slow": "slow/p331.mp3"
  },
  "p332": {
   "text": "I ended up staying home.",
   "normal": "normal/p332.mp3",
   "slow": "slow/p332.mp3"
  },
  "p333": {
   "text": "She got over her illness.",
   "normal": "normal/p333.mp3",
   "slow": "slow/p333.mp3"
  },
  "p334": {
   "text": "Let's get rid of the old clothes.",
   "normal": "normal/p334.mp3",
   "slow": "slow/p334.mp3"
  },
  "p335": {
   "text": "I got used to the cold weather.",
   "normal": "normal/p335.mp3",
   "slow": "slow/p335.mp3"
  },
  "p336": {
   "text": "He finally gave in.",
   "normal": "normal/p336.mp3",
   "slow": "slow/p336.mp3"
  },
  "p337": {
   "text": "Everything went well.",
   "normal": "normal/p337.mp3",
   "slow": "slow/p337.mp3"
  },
  "p338": {
   "text": "It has nothing to do with me.",
   "normal": "normal/p338.mp3",
   "slow": "slow/p338.mp3"
  },
  "p339": {
   "text": "It's hard to keep up with him.",
   "normal": "normal/p339.mp3",
   "slow": "slow/p339.mp3"
  },
  "p340": {
   "text": "Don't look down on others.",
   "normal": "normal/p340.mp3",
   "slow": "slow/p340.mp3"
  },
  "p341": {
   "text": "I look up to my teacher.",
   "normal": "normal/p341.mp3",
   "slow": "slow/p341.mp3"
  },
  "p342": {
   "text": "I'll make up for the lost time.",
   "normal": "normal/p342.mp3",
   "slow": "slow/p342.mp3"
  },
  "p343": {
   "text": "Don't make fun of him.",
   "normal": "normal/p343.mp3",
   "slow": "slow/p343.mp3"
  },
  "p344": {
   "text": "The machine is out of order.",
   "normal": "normal/p344.mp3",
   "slow": "slow/p344.mp3"
  },
  "p345": {
   "text": "Don't put off your homework.",
   "normal": "normal/p345.mp3",
   "slow": "slow/p345.mp3"
  },
  "p346": {
   "text": "I can't put up with the noise.",
   "normal": "normal/p346.mp3",
   "slow": "slow/p346.mp3"
  },
  "p347": {
   "text": "The plan resulted in success.",
   "normal": "normal/p347.mp3",
   "slow": "slow/p347.mp3"
  },
  "p348": {
   "text": "You can rely on me.",
   "normal": "normal/p348.mp3",
   "slow": "slow/p348.mp3"
  },
  "p349": {
   "text": "I'll stand by you.",
   "normal": "normal/p349.mp3",
   "slow": "slow/p349.mp3"
  },
  "p350": {
   "text": "Take advantage of this chance.",
   "normal": "normal/p350.mp3",
   "slow": "slow/p350.mp3"
  },
  "p351": {
   "text": "The story turned out to be true.",
   "normal": "normal/p351.mp3",
   "slow": "slow/p351.mp3"
  },
  "p352": {
   "text": "Your help made a difference.",
   "normal": "normal/p352.mp3",
   "slow": "slow/p352.mp3"
  },
  "p353": {
   "text": "He is making progress in English.",
   "normal": "normal/p353.mp3",
   "slow": "slow/p353.mp3"
  },
  "p354": {
   "text": "Sports play an important role in our life.",
   "normal": "normal/p354.mp3",
   "slow": "slow/p354.mp3"
  },
  "p355": {
   "text": "We paid a visit to our teacher.",
   "normal": "normal/p355.mp3",
   "slow": "slow/p355.mp3"
  },
  "p356": {
   "text": "The rain prevented us from going out.",
   "normal": "normal/p356.mp3",
   "slow": "slow/p356.mp3"
  },
  "p357": {
   "text": "Noise kept me from sleeping.",
   "normal": "normal/p357.mp3",
   "slow": "slow/p357.mp3"
  },
  "p358": {
   "text": "I would rather stay home.",
   "normal": "normal/p358.mp3",
   "slow": "slow/p358.mp3"
  },
  "p359": {
   "text": "The train is about to leave.",
   "normal": "normal/p359.mp3",
   "slow": "slow/p359.mp3"
  },
  "p360": {
   "text": "The movie is based on a true story.",
   "normal": "normal/p360.mp3",
   "slow": "slow/p360.mp3"
  },
  "p361": {
   "text": "He is capable of running fast.",
   "normal": "normal/p361.mp3",
   "slow": "slow/p361.mp3"
  },
  "p362": {
   "text": "The street was crowded with people.",
   "normal": "normal/p362.mp3",
   "slow": "slow/p362.mp3"
  },
  "p363": {
   "text": "She is fond of music.",
   "normal": "normal/p363.mp3",
   "slow": "slow/p363.mp3"
  },
  "p364": {
   "text": "Fruit is good for you.",
   "normal": "normal/p364.mp3",
   "slow": "slow/p364.mp3"
  },
  "p365": {
   "text": "He is responsible for the mistake.",
   "normal": "normal/p365.mp3",
   "slow": "slow/p365.mp3"
  },
  "p366": {
   "text": "I'm supposed to meet him at noon.",
   "normal": "normal/p366.mp3",
   "slow": "slow/p366.mp3"
  },
  "p367": {
   "text": "I'm willing to help you.",
   "normal": "normal/p367.mp3",
   "slow": "slow/p367.mp3"
  },
  "p368": {
   "text": "Thanks to you, I passed the test.",
   "normal": "normal/p368.mp3",
   "slow": "slow/p368.mp3"
  },
  "p369": {
   "text": "I had tea instead of coffee.",
   "normal": "normal/p369.mp3",
   "slow": "slow/p369.mp3"
  },
  "p370": {
   "text": "On the other hand, he likes math.",
   "normal": "normal/p370.mp3",
   "slow": "slow/p370.mp3"
  },
  "p371": {
   "text": "I bought a pair of shoes.",
   "normal": "normal/p371.mp3",
   "slow": "slow/p371.mp3"
  },
  "p372": {
   "text": "This is a kind of fruit.",
   "normal": "normal/p372.mp3",
   "slow": "slow/p372.mp3"
  },
  "p373": {
   "text": "More and more people use smartphones.",
   "normal": "normal/p373.mp3",
   "slow": "slow/p373.mp3"
  },
  "p374": {
   "text": "According to the news, it will snow.",
   "normal": "normal/p374.mp3",
   "slow": "slow/p374.mp3"
  },
  "p375": {
   "text": "As for me, I like summer.",
   "normal": "normal/p375.mp3",
   "slow": "slow/p375.mp3"
  },
  "p376": {
   "text": "By the time I got home, it was dark.",
   "normal": "normal/p376.mp3",
   "slow": "slow/p376.mp3"
  },
  "p377": {
   "text": "The train was late due to snow.",
   "normal": "normal/p377.mp3",
   "slow": "slow/p377.mp3"
  },
  "p378": {
   "text": "We played in spite of the rain.",
   "normal": "normal/p378.mp3",
   "slow": "slow/p378.mp3"
  },
  "p379": {
   "text": "She is in charge of the club.",
   "normal": "normal/p379.mp3",
   "slow": "slow/p379.mp3"
  },
  "p380": {
   "text": "I'm in favor of the plan.",
   "normal": "normal/p380.mp3",
   "slow": "slow/p380.mp3"
  },
  "p381": {
   "text": "No matter what happens, I'll try.",
   "normal": "normal/p381.mp3",
   "slow": "slow/p381.mp3"
  },
  "p382": {
   "text": "I speak on behalf of our class.",
   "normal": "normal/p382.mp3",
   "slow": "slow/p382.mp3"
  },
  "p383": {
   "text": "He broke it on purpose.",
   "normal": "normal/p383.mp3",
   "slow": "slow/p383.mp3"
  },
  "p384": {
   "text": "So far, I've read three books.",
   "normal": "normal/p384.mp3",
   "slow": "slow/p384.mp3"
  },
  "p385": {
   "text": "She speaks not only English but also French.",
   "normal": "normal/p385.mp3",
   "slow": "slow/p385.mp3"
  },
  "p386": {
   "text": "You can have either tea or coffee.",
   "normal": "normal/p386.mp3",
   "slow": "slow/p386.mp3"
  },
  "p387": {
   "text": "He is old enough to drive.",
   "normal": "normal/p387.mp3",
   "slow": "slow/p387.mp3"
  },
  "p388": {
   "text": "I'll show you around the city.",
   "normal": "normal/p388.mp3",
   "slow": "slow/p388.mp3"
  },
  "p389": {
   "text": "It is important for us to study.",
   "normal": "normal/p389.mp3",
   "slow": "slow/p389.mp3"
  },
  "p390": {
   "text": "You can stay as long as you like.",
   "normal": "normal/p390.mp3",
   "slow": "slow/p390.mp3"
  },
  "p391": {
   "text": "As many as 500 people came.",
   "normal": "normal/p391.mp3",
   "slow": "slow/p391.mp3"
  },
  "p392": {
   "text": "The school provides us with books.",
   "normal": "normal/p392.mp3",
   "slow": "slow/p392.mp3"
  },
  "p393": {
   "text": "This photo reminds me of my trip.",
   "normal": "normal/p393.mp3",
   "slow": "slow/p393.mp3"
  },
  "p394": {
   "text": "I study hard so that I can pass.",
   "normal": "normal/p394.mp3",
   "slow": "slow/p394.mp3"
  },
  "p395": {
   "text": "The more you read, the more you learn.",
   "normal": "normal/p395.mp3",
   "slow": "slow/p395.mp3"
  },
  "p396": {
   "text": "I don't know whether he will come or not.",
   "normal": "normal/p396.mp3",
   "slow": "slow/p396.mp3"
  }
 }
}